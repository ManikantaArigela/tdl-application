# Backend environment variables
PORT=5001

# MongoDB connection string. Local by default; point at Atlas or a replica set
# in production. Transactions (atomic reorder) require a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/nova_notes

# Google Gemini (AI planner, note enhancer, summarizer). Get a key at
# https://aistudio.google.com/apikey. Leave blank to disable AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
