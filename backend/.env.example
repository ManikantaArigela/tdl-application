# Backend environment variables
PORT=5001

# Supabase project (Project Settings → API).
# Use the public anon/publishable key. The backend sends the signed-in user's
# access token with every request, so RLS enforces per-user isolation. The
# service-role key is intentionally NOT used.
SUPABASE_URL=https://qqgpstwnnttkhqjlcbkb.supabase.co
SUPABASE_ANON_KEY=sb_publishable_efZe_DMCQBDW64JLnRiVDA_M3HY2Uzf

# Google Gemini (AI planner, note enhancer, summarizer). Get a key at
# https://aistudio.google.com/apikey. Leave blank to disable AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
