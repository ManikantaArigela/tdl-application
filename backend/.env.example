# Backend environment variables
PORT=5001

# MongoDB connection string. Include the database name before the "?".
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nova_notes?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login JWTs. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional. Defaults to 30d. Accepts any jsonwebtoken duration ("12h", "7d").
JWT_EXPIRES_IN=30d

# Optional brute-force guard: max credential attempts per IP+email per 15 min.
AUTH_RATE_LIMIT_MAX=20

# Optional: set to false if you create MongoDB indexes out of band.
MONGO_AUTO_INDEX=true

# Google Gemini (AI planner, note enhancer, summarizer). Get a key at
# https://aistudio.google.com/apikey. Leave blank to disable AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the primary model is overloaded or rate-limited.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional: base backoff for retrying an overloaded model, in milliseconds.
GEMINI_RETRY_BASE_MS=700

# ---------- Voice call reminders (free SIP) ----------
# console = dry run: log the prompt instead of dialing. ari = real calls
# through Asterisk on your Oracle Cloud Always Free VM.
VOICE_PROVIDER=console
SIP_DOMAIN=sip.linphone.org

# Asterisk ARI (only used when VOICE_PROVIDER=ari).
ARI_URL=http://127.0.0.1:8088
ARI_USER=nova
ARI_PASSWORD=
ARI_APP=nova-voice

# Outbound route to the free Linphone SIP service. The default originates
# PJSIP/<sip-user>@linphone; override the template for another trunk.
VOICE_SIP_TRUNK=linphone
VOICE_SIP_ENDPOINT_TEMPLATE=
# Optional ARI caller ID override. Leave blank to use callerid from pjsip.conf.
VOICE_CALLER_ID=
VOICE_RING_SECONDS=30
VOICE_MAX_CALL_SECONDS=45

# Abuse caps. Calls stop after this many attempts per user per local day.
MAX_CALLS_PER_USER_PER_DAY=6
VOICE_RETRY_MINUTES=5

# ---------- Scheduler ----------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_BATCH_SIZE=25
# Set on a free host that sleeps and is woken by an external cron.
CRON_SECRET=

# ---------- Web Push (VAPID) ----------
# Leave blank in development: the server generates backend/var/vapid.json.
# In production generate once and keep them secret:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- TTS ----------
# Edge TTS needs no key. ffmpeg must be on PATH for 8 kHz WAV conversion.
TTS_CACHE_DIR=
# Required for spoken prompts on real calls: Asterisk reads cached WAVs here.
# Without it, calls still connect but play a beep instead of the TTS prompt.
ASTERISK_SOUNDS_DIR=
ASTERISK_SOUND_PREFIX=nova
