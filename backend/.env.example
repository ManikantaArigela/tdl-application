# Backend environment variables
PORT=5001

# MongoDB connection string. Include the database name before the "?".
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nova_notes?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login JWTs. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional. Defaults to 30d. Accepts any jsonwebtoken duration ("12h", "7d").
JWT_EXPIRES_IN=30d

# Optional brute-force guard: max credential attempts per IP+email per 15 min.
AUTH_RATE_LIMIT_MAX=20

# Optional: set to false if you create MongoDB indexes out of band.
MONGO_AUTO_INDEX=true

# Google Gemini (AI planner, note enhancer, summarizer). Get a key at
# https://aistudio.google.com/apikey. Leave blank to disable AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
