{
  "name": "nova-notes-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for TDL - Notes & Todo application",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test --test-concurrency=1",
    "import": "node --env-file-if-exists=.env scripts/import-json.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongoose": "^8.24.6"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
