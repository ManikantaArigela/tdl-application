{
  "name": "nova-notes-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for TDL - Notes & Todo application",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test --test-concurrency=1",
    "import": "node --env-file-if-exists=.env scripts/import-data.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7"
  }
}
